uniform shader outlineDistance;
uniform float3 axisX;
uniform float3 axisY;
uniform float3 axisZ;
uniform float pixelSize;
layout(color) uniform half4 baseColor;

float3 surfaceAt(float2 p) {
    float2 tex=(p+1.3)*(768.0/2.6)-0.5;
    float2 cell=floor(tex)+0.5, f=fract(tex);
    float3 a=float3(outlineDistance.eval(cell).rgb);
    float3 b=float3(outlineDistance.eval(cell+float2(1,0)).rgb);
    float3 c=float3(outlineDistance.eval(cell+float2(0,1)).rgb);
    float3 d=float3(outlineDistance.eval(cell+float2(1,1)).rgb);
    return mix(mix(a,b,f.x),mix(c,d,f.x),f.y);
}
float field(float3 p) {
    float d=surfaceAt(p.xy).x;
    // A round bevel and a gently domed face, with the exact supplied 2D outline.
    float2 q=float2(max(d+0.62,0.0),p.z);
    return length(q)-0.62;
}
float3 objectPoint(float3 p) {
    return float3(dot(p,axisX),dot(p,axisY),dot(p,axisZ));
}
half4 main(float2 xy) {
    float radial=dot(xy,xy);
    if(radial>2.25) return half4(0.0);
    float extent=sqrt(2.25-radial);
    float z=extent;
    float nearest=10.0;
    float3 best=float3(0.0);
    for(int i=0;i<80;i++) {
        float3 p=objectPoint(float3(xy,z));
        float d=field(p);
        if(d<nearest) { nearest=d;best=p; }
        if(d<0.0007 || z < -extent) break;
        z-=max(d*0.75,0.0005);
    }
    float coverage=1.0-smoothstep(0.0005,pixelSize*1.4,nearest);
    if(coverage<0.005) return half4(0.0);
    // The distance texture also stores a smooth analytic 2D gradient. This avoids
    // differentiating half-float samples, which would amplify quantization bands.
    float3 surfaceData=surfaceAt(best.xy);
    float2 q=float2(max(surfaceData.x+0.62,0.0),best.z);
    float3 n=normalize(float3(q.x*surfaceData.yz,q.y));
    // Blend the broad face toward a soft dome so the outline's medial axes
    // cannot create diagonal lighting creases on squares, stars or hexagons.
    float domeBlend=0.92*smoothstep(0.05,0.48,-surfaceData.x);
    float3 domeNormal=normalize(float3(best.xy*0.65,best.z));
    n=normalize(mix(n,domeNormal,domeBlend));
    n=normalize(n.x*axisX+n.y*axisY+n.z*axisZ);
    float3 key=normalize(float3(-0.50,-0.65,0.85));
    float3 fill=normalize(float3(0.8,0.1,0.6));
    float diffuse=0.38+0.65*max(dot(n,key),0.0)+0.12*max(dot(n,fill),0.0);
    float spec=0.10*pow(max(dot(n,normalize(key+float3(0,0,1))),0.0),24.0);
    float rim=0.035*pow(1.0-max(n.z,0.0),3.0);
    float3 color=fromLinearSrgb(toLinearSrgb(baseColor.rgb)*diffuse+float3(spec+rim));
    float noise=fract(52.9829189*fract(dot(floor(xy/pixelSize),float2(0.06711056,0.00583715))))-0.5;
    color+=noise/255.0;
    return half4(half3(clamp(color,0.0,1.0))*half(coverage),half(coverage));
}
