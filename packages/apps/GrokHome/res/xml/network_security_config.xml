<network-security-config>
    <!-- Native endpoint validation permits HTTP only for loopback/RFC1918 IPs. -->
    <base-config cleartextTrafficPermitted="true"/>
    <!-- ADB reverse exposes the development token broker on device loopback. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain><domain includeSubdomains="false">127.0.0.1</domain><domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
